# Quiz sobre poluição: 
@bot.command()
async def quiz(ctx):
    questions = [
        {
            "question": "Qual é a principal causa da poluição do ar?",
            "options": ["Queima de combustíveis fósseis", "Desmatamento", "Uso de pesticidas", "Reciclagem"],
            "answer": 0
        },
        {
            "question": "Qual é o efeito da poluição da água nos ecossistemas aquáticos?",
            "options": ["Aumento da biodiversidade", "Diminuição da qualidade da água", "Melhoria na saúde dos peixes", "Aumento da oxigenação"],
            "answer": 1
        },
        {
            "question": "Qual é a principal fonte de poluição sonora nas cidades?",
            "options": ["Tráfego de veículos", "Indústrias", "Construção civil", "Eventos culturais"],
            "answer": 0
        }
    ]

    score = 0
    for q in questions:
        options_text = "\n".join([f"{i+1}. {option}" for i, option in enumerate(q["options"])])
        await ctx.send(f"{q['question']}\n{options_text}")

        def check(m):
            return m.author == ctx.author and m.content.isdigit() and 1 <= int(m.content) <= len(q["options"])

        try:
            msg = await bot.wait_for('message', check=check, timeout=30.0)
            if int(msg.content) - 1 == q["answer"]:
                score += 1
                await ctx.send("Resposta correta!")
            else:
                await ctx.send(f"Resposta incorreta! A resposta correta era: {q['options'][q['answer']]}")
        except asyncio.TimeoutError:
            await ctx.send("Tempo esgotado! Próxima pergunta.")

    await ctx.send(f"Quiz finalizado! Sua pontuação: {score}/{len(questions)}")

