# Impacto
@bot.command()
async def impacto(ctx, material=None):

    await ctx.send(
        "🌍 **O descarte incorreto do lixo é um problema ambiental muito sério!**\n\n"
        "Quando jogamos resíduos em locais inadequados, podemos contaminar "
        "o solo, poluir rios e oceanos e prejudicar os animais. Além disso, "
        "muitos materiais que poderiam ser reciclados acabam desperdiçados. "
        "Pequenas atitudes, como separar o lixo e reutilizar materiais, "
        "ajudam a proteger o meio ambiente. Faça sua parte! ♻️"
    )

    if material is None:
        return

    material = material.lower()

    if material == "plastico":
        await ctx.send("🌊 O descarte incorreto de plástico pode poluir rios e oceanos, prejudicando os animais.")

    elif material == "papel":
        await ctx.send("🌳 O desperdício de papel aumenta a demanda por matéria-prima e pode contribuir para o desmatamento.")

    elif material == "vidro":
        await ctx.send("⚠️ O vidro descartado incorretamente pode causar acidentes e permanecer no ambiente por muito tempo.")

    elif material == "metal":
        await ctx.send("🏭 O descarte incorreto de metais desperdiça materiais recicláveis e pode contaminar o ambiente.")

    else:
        await ctx.send("Não tenho informações sobre esse material ainda. Tente plastico, papel, vidro ou metal!")

